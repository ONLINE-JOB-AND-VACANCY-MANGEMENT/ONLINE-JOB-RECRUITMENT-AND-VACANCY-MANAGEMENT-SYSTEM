APP_NAME="AASTU JobPortal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.SERVER_IP.sslip.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aastu_jobportal
DB_USERNAME=aastu_jobportal
DB_PASSWORD=replace-with-a-long-random-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated browser origins. Do not add a trailing slash.
CORS_ALLOWED_ORIGINS=https://app.SERVER_IP.sslip.io
